# Backend
CARDIOFLOW_DB_PATH=data/cardioflow.db
CARDIOFLOW_EXTRACTION_PROVIDER=mock          # only supported provider in this build
CARDIOFLOW_MOCK_SCENARIO=default             # default | invalid_json | envelope_invalid | item_errors | hallucinated
CARDIOFLOW_DEMO_CLINICIAN=Dr. A. Reyes
CARDIOFLOW_CORS_ORIGINS=http://localhost:3000

# Frontend server (browser requests remain same-origin at /api/*)
CARDIOFLOW_API_ORIGIN=http://127.0.0.1:8010
